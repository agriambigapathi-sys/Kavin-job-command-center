rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the document belongs to the signed-in user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if document data belongs to user or is null on get
    function isDocOwner() {
      return isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Helper function to verify incoming ownerId matches the user
    function incomingOwnerMatches() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Helper function to ensure ownerId is unchanged on updates
    function existingOwnerMatches() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 1. userProfiles: document ID is ownerId
    match /userProfiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.ownerId == userId;
      allow update: if isOwner(userId) && request.resource.data.ownerId == userId;
      allow delete: if isOwner(userId);
    }

    // 2. jobs
    match /jobs/{jobId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 3. jobDescriptions
    match /jobDescriptions/{jdId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 4. applications
    match /applications/{applicationId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 5. contacts
    match /contacts/{contactId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 6. followUps
    match /followUps/{followUpId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 7. interviews
    match /interviews/{interviewId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 8. resumes
    match /resumes/{resumeId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 9. coverLetters
    match /coverLetters/{coverLetterId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 10. messages
    match /messages/{messageId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 11. activity
    match /activity/{activityId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }

    // 12. jobAnalyses
    match /jobAnalyses/{analysisId} {
      allow get: if isDocOwner();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if incomingOwnerMatches();
      allow update: if existingOwnerMatches() && incomingOwnerMatches();
      allow delete: if existingOwnerMatches();
    }
  }
}
